# LLM provider configuration — the agent speaks the OpenAI-compatible
# chat completions format, so any provider below (or compatible) works.
# Copy this file to .env and fill in ONE provider's values.

# --- Anthropic Claude (default; via its OpenAI-compatible endpoint) ---
# Opus for output quality; swap LLM_MODEL to claude-sonnet-5 for a cheaper run.
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-opus-5

# --- Groq (free tier) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your-key-here
# LLM_MODEL=llama-3.3-70b-versatile
# Free tier caps total tokens/request — cap the agent's output budget too:
# LLM_MAX_OUTPUT_TOKENS=6000
# Reasoning models (gpt-oss) spend thinking tokens from the output budget —
# keep reasoning short on tight tiers:
# LLM_REASONING_EFFORT=low

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4.1

# --- Google Gemini (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-google-api-key
# LLM_MODEL=gemini-2.5-flash

# --- OpenRouter ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-your-key-here
# LLM_MODEL=anthropic/claude-sonnet-4.5

# Optional: hard cap on LLM calls per run (cost guard, default 60)
# AGENT_MAX_LLM_CALLS=60
# Optional: output-token budget per LLM call (auto-halves down to 2000 on provider size rejections, default 16000)
# LLM_MAX_OUTPUT_TOKENS=16000

# Optional: per-request timeout in ms (default 120000) — raise for slow free-tier queues
# LLM_TIMEOUT_MS=480000

# Optional: append a one-line diagnosis to repair briefings when a loop is stuck
# AGENT_REPAIR_HINT=
